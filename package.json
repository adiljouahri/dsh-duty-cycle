{
  "name": "dsh-duty-cycle",
  "version": "1.6.0",
  "private": true,
  "description": "DSH duty-cycle plugin (custom fork) — duty cycle only: pause 15 min, run 45 min, repeat. Running commands and in-flight requests are never interrupted.",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhu168/dsh-save-money.git"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "typecheck": "node scripts/typecheck.js",
    "pack": "cd plugin && npm pack",
    "test": "npm run prepare && node --test tests/cycle.test.js",
    "prepare": "node scripts/build.js && node scripts/make-plugin.js"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "type": "module"
}
